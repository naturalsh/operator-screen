{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nature-shield.example/schemas/responder.schema.json",
  "title": "Responder",
  "description": "A place crews are sent from. File layout: {\"metadata\": {...}, \"records\": [Responder, ...]}. Optional: without it the Dispatch step is disabled.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "fire_station",
        "gendarmerie",
        "police",
        "other"
      ]
    },
    "place": {
      "type": "object",
      "properties": {
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      "required": [
        "lon",
        "lat"
      ]
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Tool, model or archive that produced the record."
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "Link to the original record, page or repository."
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the producing tool fetched or exported the record (UTC)."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the thing happened in the world (UTC)."
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the platform received it (UTC)."
    },
    "synthetic": {
      "type": "boolean",
      "description": "true for invented sample data; the screen labels such records SYNTHETIC."
    }
  },
  "required": [
    "id",
    "name",
    "kind",
    "place",
    "schema_version",
    "source",
    "source_url",
    "license",
    "fetched_at",
    "observed_at",
    "received_at"
  ],
  "additionalProperties": true
}
