{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naturalsh.github.io/operator-screen/schemas/forecast_library.schema.json",
  "title": "ForecastRun",
  "description": "One forecast the operator can load with 'Update forecast': precomputed (forecast_library.json, tools/build_forecast_library.py) or the answer of a live model server (docs/forecast_api.md). Only observations acquired by issued_at are used.",
  "type": "object",
  "required": ["id", "issued_at", "trigger", "initialised_from", "start_area_km2", "contours", "reach"],
  "properties": {
    "id": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" },
    "trigger": { "enum": ["ignition", "observation", "scheduled", "live"], "description": "ignition; a new VIIRS / Sentinel-2 observation; a scheduled 30-minute step (same perimeter, new weather); computed live" },
    "initialised_from": { "type": "string", "description": "e.g. 'VIIRS perimeter', 'ignition point'" },
    "last_observation_at": { "type": "string", "format": "date-time" },
    "last_observation_label": { "type": "string", "description": "e.g. 'VIIRS N20'" },
    "start_area_km2": { "type": "number", "minimum": 0 },
    "contours": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["horizon_hours", "valid_at", "area_km2", "geometry"],
        "properties": {
          "horizon_hours": { "type": "number", "exclusiveMinimum": 0 },
          "valid_at": { "type": "string", "format": "date-time" },
          "area_km2": { "type": "number", "minimum": 0 },
          "geometry": { "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "enum": ["Polygon", "MultiPolygon"] } } }
        }
      }
    },
    "reach": {
      "type": "array",
      "description": "[street, hours after issued_at] for every street the P >= 50 % contour reaches within 12 h; street = index into the library's streets list, or a street id from a live server",
      "items": { "type": "array", "prefixItems": [{ "type": ["integer", "string"] }, { "type": "number", "exclusiveMinimum": 0 }], "minItems": 2, "maxItems": 2 }
    }
  }
}
